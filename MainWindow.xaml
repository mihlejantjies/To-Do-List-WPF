<Window x:Class="TodoListWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To-Do List" Height="450" Width="400"
        MinHeight="300" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="Auto"/>   <!-- Add task row -->
            <RowDefinition Height="*"/>      <!-- Task list -->
            <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0" Text="My To-Do List"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Text box + Add button -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TaskTextBox" Grid.Column="0"
                     FontSize="16" Padding="5"
                     KeyDown="TaskTextBox_KeyDown"/>

            <Button x:Name="AddButton" Grid.Column="1"
                    Content="Add" Width="70" Margin="8,0,0,0"
                    Click="AddButton_Click"/>
        </Grid>

        <!-- The list of tasks -->
        <ListBox x:Name="TaskListBox" Grid.Row="2" FontSize="16"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DoneButton" Content="Mark Done"
                    Width="100" Padding="5" Margin="0,0,8,0"
                    Click="DoneButton_Click"/>
            <Button x:Name="DeleteButton" Content="Delete"
                    Width="100" Padding="5"
                    Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
